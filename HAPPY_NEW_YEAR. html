<script>
/* ---------- Countdown ---------- */
const sequence=[
  {t:"Get Ready...",c:"count-text"},
  {t:"5",c:"count-num"},
  {t:"4",c:"count-num"},
  {t:"3",c:"count-num"},
  {t:"2",c:"count-num"},
  {t:"1",c:"count-num"},
  {t:"IT'S TIME!!!",c:"count-text"}
];

let step=0;
const cd=document.getElementById("countdown");

const timer=setInterval(()=>{
  cd.innerHTML=`<div class="${sequence[step].c}">${sequence[step].t}</div>`;
  step++;
  if(step===sequence.length){
    clearInterval(timer);
    setTimeout(startShow,800);
  }
},1000);

/* ---------- Start Show ---------- */
function startShow() {
  document.body.classList.add("focus-mode");
  cd.style.display = "none";
  
  const after = document.getElementById("after");
  after.style.visibility = "visible";
  after.style.pointerEvents = "auto";
  
  unlockAudio();
  startBigFirework();
  setTimeout(startFireworks, 1200);
  initCarousel();
}

/* ---------- Audio (mobile-safe) ---------- */
function unlockAudio(){
  const audio=document.getElementById("music");
  audio.volume=0.8;

  audio.play().catch(()=>{
    document.body.addEventListener("touchstart",()=>audio.play(),{once:true});
    document.body.addEventListener("click",()=>audio.play(),{once:true});
  });
}

/* ---------- Big Center Firework ---------- */
function startBigFirework() {
  const c = document.getElementById("fireworks");
  const x = c.getContext("2d");
  c.width = innerWidth;
  c.height = innerHeight;

  const centerX = c.width / 2;
  const centerY = c.height / 2;

  let sparks = [];

  // Create initial sparks
  for (let i = 0; i < 200; i++) {
    const angle = Math.random() * Math.PI * 2;
    const speed = Math.random() * 6 + 2;
    sparks.push({
      x: centerX,
      y: centerY,
      vx: Math.cos(angle) * speed,
      vy: Math.sin(angle) * speed,
      life: 1,
      hue: Math.random() * 360
    });
  }

  (function anim() {
    x.fillStyle = "rgba(0,0,0,0.15)";
    x.fillRect(0, 0, c.width, c.height);

    sparks.forEach((p, i) => {
      p.x += p.vx;
      p.y += p.vy;
      p.vy += 0.05; // gravity
      p.life -= 0.02;

      x.globalAlpha = p.life;
      x.fillStyle = `hsl(${p.hue}, 100%, 50%)`;
      x.beginPath();
      x.arc(p.x, p.y, 3, 0, Math.PI * 2);
      x.fill();

      if (p.life <= 0) sparks.splice(i, 1);
    });

    x.globalAlpha = 1;

    if (sparks.length > 0) requestAnimationFrame(anim);
  })();
  /* ===== NEW FLOATING MESSAGE LOGIC ===== */
  const floatingMessage = document.getElementById("floatingMessage");
  let floated = false;

  function showFloatingMessage(){
    floatingMessage.classList.add("show");

    // Auto move after 3 seconds
    setTimeout(moveFloatingMessage, 3000);
  }

  function moveFloatingMessage(){
    if(floated) return;
    floated = true;
    floatingMessage.classList.add("shrink");
}
function vanishFloatingMessage() {
  if (!floated) moveFloatingMessage();
  
  floatingMessage.classList.add("vanish");
  
  // Start music on FIRST interaction (browser-safe)
  const audio = document.getElementById("music");
  audio.play().catch(() => {});
  
  setTimeout(() => {
    document.body.classList.remove("focus-mode");
    document.getElementById("instructions").style.opacity = "1";
  }, 900);
}

/* Auto vanish after 3s */
setTimeout(vanishFloatingMessage, 3000);

/* User interaction vanish */
["click","touchstart"].forEach(evt=>{
  document.addEventListener(evt, vanishFloatingMessage, { once:true });
}); 

  /* User interaction triggers move */
  ["click","touchstart"].forEach(evt=>{
    document.addEventListener(evt, moveFloatingMessage, { once:true });
  });
/* ===== END FLOATING MESSAGE LOGIC ===== */

  setTimeout(showFloatingMessage, 900);
}

/* ---------- Carousel ---------- */
const track=document.getElementById("track");
const carousel=document.getElementById("carousel");
const dotsContainer=document.getElementById("dots");
const slides=document.querySelectorAll(".slide");
let index=0,startX=0,isDown=false;
let autoSlideInterval;

function update(){
  track.style.transform=`translateX(-${index*100}%)`;
  document.querySelectorAll('.dot').forEach((dot,i)=>{
    dot.classList.toggle('active', i===index);
  });
}

function createDots(){
  for(let i=0;i<slides.length;i++){
    const dot=document.createElement('div');
    dot.classList.add('dot');
    if(i===0) dot.classList.add('active');
    dot.addEventListener('click',()=>{ index=i; update(); resetAutoSlide(); });
    dotsContainer.appendChild(dot);
  }
}

function resetAutoSlide(){
  clearInterval(autoSlideInterval);
  autoSlideInterval = setInterval(()=>{ index=(index+1)%slides.length; update(); }, 10000);
}

function initCarousel(){
  createDots();
  resetAutoSlide();
}

/* Swipe */
carousel.addEventListener("touchstart",e=>{ startX=e.touches[0].clientX; });
carousel.addEventListener("touchend",e=>{
  const diff=e.changedTouches[0].clientX-startX;
  if(diff>50) index=Math.max(0,index-1);
  if(diff<-50) index=Math.min(slides.length-1,index+1);
  update();
  resetAutoSlide();
});
carousel.addEventListener("mousedown",e=>{ isDown=true; startX=e.clientX; });
carousel.addEventListener("mouseup",e=>{
  if(!isDown) return; isDown=false;
  const diff=e.clientX-startX;
  if(diff>50) index=Math.max(0,index-1);
  if(diff<-50) index=Math.min(slides.length-1,index+1);
  update();
  resetAutoSlide();
});

/* ---------- Fireworks ---------- */
function startFireworks(){
  const c=document.getElementById("fireworks");
  const x=c.getContext("2d");
  c.width=innerWidth;
  c.height=innerHeight;

  let shells=[],sparks=[];

  setInterval(()=>{
    const depth = Math.random() < 0.5 ? 0.6 : 1;
    shells.push({
      x: Math.random() * c.width,
      y: c.height,
      vy: -(8 + Math.random() * 3),
      depth: depth,
      targetY: c.height * (depth === 1 ? 0.35 : 0.25)
    });
  },700);

  function explode(s){
    for(let i=0;i<90;i++){
      const a=Math.random()*Math.PI*2;
      const sp=Math.random()*5*s.depth;
      sparks.push({ x:s.x, y:s.y, vx:Math.cos(a)*sp, vy:Math.sin(a)*sp, life:1, d:s.depth });
    }
  }

  (function anim(){
    x.fillStyle="rgba(0,0,0,.25)";
    x.fillRect(0,0,c.width,c.height);

    shells.forEach((s,i)=>{
      s.y += s.vy;
      x.fillStyle = "white";
      x.fillRect(s.x, s.y, 2, 2);
      if(s.y <= s.targetY){ explode(s); shells.splice(i,1); }
    });

    sparks.forEach((p,i)=>{
      p.x += p.vx; p.y += p.vy; p.vy += 0.05; p.life -= 0.02;
      x.globalAlpha = p.life;
      x.fillStyle = `hsl(${Math.random()*360},100%,${p.d?70:50}%)`;
      x.beginPath(); x.arc(p.x,p.y,2.2*p.d,0,Math.PI*2); x.fill();
      if(p.life<=0) sparks.splice(i,1);
    });

    x.globalAlpha=1;
    requestAnimationFrame(anim);
  })();
}
</script>
